# Copy to .env and fill in your own sandbox credentials. Never commit .env.

# --- Duffel (flights) -------------------------------------------------------
# https://app.duffel.com -> switch to test mode -> More -> Developers -> Access tokens
# Test tokens start with duffel_test_
DUFFEL_ACCESS_TOKEN=

# --- Optional tuning (defaults shown) ----------------------------------------
# Host port for the gateway
GATEWAY_PORT=8081
# Host port for the RabbitMQ management UI (guest / guest)
RABBITMQ_MANAGEMENT_PORT=15673
# How long a supplier search result is served from Redis
SEARCH_CACHE_TTL_SECONDS=120
# Supplier search deadline
SUPPLIER_SEARCH_TIMEOUT_MS=20000
# Offers returned per search, cheapest first
MAX_OFFERS_PER_SUPPLIER=20
# Backoff between booking attempts; one retry queue is declared per value
BOOKING_RETRY_DELAYS_MS=5000,20000,60000
